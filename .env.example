# Azure AI Foundry — powers the /onboarding AI-assisted agent draft.
# Server-side only (app/api/onboarding/route.ts); never exposed to the browser.
# Use the Azure OpenAI endpoint (not the Foundry *project* endpoint) — the
# OpenAI SDK talks to it directly at /openai/v1, no api-version query param.
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=<deployment-name, e.g. gpt-5.4-mini>
