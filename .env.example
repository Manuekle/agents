# Azure AI Foundry — powers the hosted half of the /onboarding agent draft.
# Optional: with these unset, /onboarding still works against a visitor's own
# API key (Claude, OpenAI, Kimi, Ollama, …), which is configured in the browser
# and never stored here. See "Bring your own model" in the README.
# Server-side only (app/api/onboarding/route.ts); never exposed to the browser.
# Use the Azure OpenAI endpoint (not the Foundry *project* endpoint) — the
# OpenAI SDK talks to it directly at /openai/v1, no api-version query param.
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=<deployment-name, e.g. gpt-5.4-mini>

# Supabase — accounts, plans and saved agents.
#
# Optional, but note what setting them turns ON rather than off: with these
# present the composer, the AI draft and the MCP tokens all require signing in,
# and signed-out visitors get the /demo simulator instead. With them unset
# there is no way to sign in at all, so nothing is gated and agents live in
# localStorage — which is what a self-hosted instance with no accounts wants.
#
# Both values are browser-safe by design; row-level security is what protects
# the data, so never add the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Polar — billing for Pro/Max (app/api/billing/). Optional: with these unset,
# /pricing shows an honest "Coming soon" instead of a dead buy button (see
# POLAR_CONFIGURED in lib/polar/env.ts). Needs Supabase configured too — a
# subscription has to attach to an account.
#
# Product ids are NOT secret (NEXT_PUBLIC_ is correct) — one is meaningless
# without the access token below, which is what can actually check someone
# out with it.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# "sandbox" while testing; unset or "production" to charge for real.
POLAR_SERVER=sandbox
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID=
NEXT_PUBLIC_POLAR_MAX_PRODUCT_ID=

# A secret this app made up, not one Polar issued — the webhook route proves
# it holds this before apply_polar_plan() (supabase/migrations/0005_polar_billing.sql)
# will touch anyone's plan, since this project never adds the service_role key.
# Generate one (e.g. `openssl rand -hex 32`) and set the *same* value with:
#   insert into public.app_config (key, value) values
#     ('plan_sync_secret', '<the value below>')
#   on conflict (key) do update set value = excluded.value;
PLAN_SYNC_SECRET=
